{
  "name": "freecode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "bun scripts/database.ts up",
    "db:down": "bun scripts/database.ts down",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:cli": "bun --no-env-file --watch --no-clear-screen apps/cli/src/index.tsx",
    "start:server": "bun run --cwd apps/server start",
    "start:cli": "bun --no-env-file apps/cli/src/index.tsx",
    "typecheck": "bun run --workspaces --sequential typecheck",
    "test": "bun scripts/test.ts",
    "lint": "bun run --bun biome check .",
    "format": "bun run --bun biome format --write .",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
